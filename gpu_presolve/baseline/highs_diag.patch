+              name.c_str());
+      std::abort();
+    }
+    switches.off[k] = true;
+    begin = end + 1;
+  }
+  for (int k = 0; k < kDiagOffCount; ++k) {
+    if (!switches.off[k]) continue;
+    if (!switches.off_list.empty()) switches.off_list += ",";
+    switches.off_list += names[k];
+  }
+  if (switches.off_list.empty()) switches.off_list = "none";
+  switches.probing_contingent = 1000;
+  const char* contingent = std::getenv("HIGHS_DIAG_PROBING_CONTINGENT");
+  if (contingent) {
+    char* end;
+    switches.probing_contingent = std::strtoll(contingent, &end, 10);
+    if (end == contingent || *end != '\0') {
+      fprintf(stderr, "HIGHS_DIAG_PROBING_CONTINGENT: not an integer \"%s\"\n",
+              contingent);
+      std::abort();
+    }
+  }
+  const char* nostop = std::getenv("HIGHS_DIAG_PROBING_NOSTOP");
+  switches.probing_nostop = nostop && std::string(nostop) == "1";
+  return switches;
+}
+
+inline const HighsDiagSwitches& highsDiagSwitches() {
+  static const HighsDiagSwitches switches = highsDiagReadSwitches();
+  return switches;
+}
+
+inline bool highsDiagOff(const HighsDiagOff stage) {
+  return highsDiagSwitches().off[stage];
+}
+
+// Matrix entries visited by HighsDomain on the calling thread
+struct HighsDiagWork {
+  int64_t prop_sweeps = 0;
+  int64_t prop_rows = 0;
+  int64_t prop_entries = 0;
+  int64_t activity_entries = 0;
+};
+
+inline HighsDiagWork& highsDiagWork() {
+  static thread_local HighsDiagWork work;
+  return work;
+}
+
+inline double highsDiagSeconds() {
+  return std::chrono::duration<double>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}

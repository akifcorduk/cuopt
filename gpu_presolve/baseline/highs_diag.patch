+inline HighsDiagSwitches highsDiagReadSwitches() {
+  static const char* const names[kDiagOffCount] = {
+      "strengthen_inequalities", "dominated_columns", "parallel_columns",
+      "parallel_rows",           "sparsify",          "aggregator",

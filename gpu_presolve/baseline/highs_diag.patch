+               diag_.parallel_col_reductions - diag_.parallel_cols_merged,
+               diag_.parallel_rows_removed, diag_.parallel_cols_removed,
+               diag_.parallel_hash_seconds, diag_.parallel_col_seconds,
+               diag_.parallel_row_seconds);
+
+  int64_t fixingCount = 0;
+  int64_t fixingNnz = 0;
+  for (HighsInt rule = 0; rule != kDiagFixCount; ++rule) {
+    if (diag_.fixing_count[rule] == 0) continue;
+    fixingCount += diag_.fixing_count[rule];
+    fixingNnz += diag_.fixing_nnz[rule];
+    highsLogUser(log_options, HighsLogType::kInfo,

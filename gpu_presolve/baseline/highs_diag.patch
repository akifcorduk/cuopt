+      break;
+    case HighsPresolveStatus::kNotReduced:
+      status = "not_reduced";
+      break;
+    case HighsPresolveStatus::kInfeasible:
+      status = "infeasible";
+      break;
+    case HighsPresolveStatus::kUnboundedOrInfeasible:
+      status = "unbounded_or_infeasible";
+      break;
+    case HighsPresolveStatus::kReduced:
+      status = "reduced";
+      break;
+    case HighsPresolveStatus::kReducedToEmpty:
+      status = "reduced_to_empty";
+      break;
+    case HighsPresolveStatus::kTimeout:
+      status = "timeout";
+      break;
+    case HighsPresolveStatus::kNullError:
+      status = "null_error";
+      break;
+    case HighsPresolveStatus::kOptionsError:
+      status = "options_error";
+      break;
+    case HighsPresolveStatus::kOutOfMemory:
+      status = "out_of_memory";
+      break;
+    case HighsPresolveStatus::kException:
+      status = "exception";
+      break;
+    case HighsPresolveStatus::kMatrixValueError:
+      status = "matrix_value_error";
+      break;
+  }
+  highsLogUser(log_options, HighsLogType::kInfo,
+               "DIAG total presolve_seconds=%.6f rows=%" PRId64 ":%" PRId64
+               " cols=%" PRId64 ":%" PRId64 " nnz=%" PRId64 ":%" PRId64
+               " integer_cols=%" PRId64 ":%" PRId64
+               " implied_integer_cols=%" PRId64
+               " status=%s stopped=%d restart=%" HIGHSINT_FORMAT "\n",
+               seconds, rows, rowsNow, cols, colsNow, nnz, nnzNow, integerCols,
+               integerColsNow, impliedIntegerCols, status, diag_.stopped,
+               mipsolver->mipdata_->numRestarts);
+}

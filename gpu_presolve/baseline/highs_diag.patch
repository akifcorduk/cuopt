+               " row_additions=%" PRId64 " cols_merged=%" PRId64
+               " cols_dominated=%" PRId64 " rows_removed=%" PRId64
+               " cols_removed=%" PRId64
+               " hash_seconds=%.6f col_seconds=%.6f row_seconds=%.6f\n",
+               diag_.parallel_duplicate_rows, diag_.parallel_row_additions,
+               diag_.parallel_cols_merged,

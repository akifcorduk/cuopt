+HPresolve::DiagProbingRound::DiagProbingRound(HPresolve& presolve)
+    : presolve(presolve),
+      start(highsDiagSeconds()),
+      probed_start(presolve.numProbed) {
+  cliques_entry = presolve.mipsolver->mipdata_->cliquetable.numCliques();
+}
+
+void HPresolve::DiagProbingRound::beginLoop() {
+  const HighsMipSolverData& mipdata = *presolve.mipsolver->mipdata_;
+  cliques_before = mipdata.cliquetable.numCliques();
+  implications_before = mipdata.implications.getNumImplications();
+  in_loop = true;
+  loop_work = highsDiagWork();
+  loop_start = highsDiagSeconds();
+}
+
+void HPresolve::DiagProbingRound::endProbe(const HighsDiagWork& before) {
+  const HighsDiagWork& work = highsDiagWork();
+  max_probe_work = std::max(
+      max_probe_work, work.prop_entries - before.prop_entries +
+                          work.activity_entries - before.activity_entries);
+  max_probe_sweeps =
+      std::max(max_probe_sweeps, work.prop_sweeps - before.prop_sweeps);
+}
+
+void HPresolve::DiagProbingRound::endLoop() {
+  loop_end = highsDiagSeconds();
+  in_loop = false;
+  const HighsDiagWork& work = highsDiagWork();
+  loop_work.prop_sweeps = work.prop_sweeps - loop_work.prop_sweeps;
+  loop_work.prop_rows = work.prop_rows - loop_work.prop_rows;
+  loop_work.prop_entries = work.prop_entries - loop_work.prop_entries;
+  loop_work.activity_entries =
+      work.activity_entries - loop_work.activity_entries;
+  const HighsMipSolverData& mipdata = *presolve.mipsolver->mipdata_;
+  cliques_after = mipdata.cliquetable.numCliques();
+  implications = mipdata.implications.getNumImplications();
+}
+
+HPresolve::DiagProbingRound::~DiagProbingRound() {
+  if (in_loop) endLoop();
+  const double end = highsDiagSeconds();
+  const bool looped = loop_end != 0;
+  if (!looped) {
+    cliques_before = presolve.mipsolver->mipdata_->cliquetable.numCliques();
+    cliques_after = cliques_before;
+  }
+  const int64_t probed = presolve.numProbed - probed_start;
+  Diag& diag = presolve.diag_;
+  if (diag.probing_rounds == 0) {
+    diag.probing_binaries = binaries;
+    diag.probing_cliques_before = cliques_before;
+  }
+  ++diag.probing_rounds;
+  diag.probing_attempted += attempted;
+  diag.probing_probed += probed;
+  diag.probing_fixed += fixed;
+  diag.probing_bounds_tightened += bounds_tightened;
+  diag.probing_substitutions += substitutions;
+  diag.probing_lifted_nonzeros += lifted_nonzeros;
+  diag.probing_cliques_after = cliques_after;
+  if (looped) diag.probing_implications = implications;
+  diag.probing_max_probe_work =
+      std::max(diag.probing_max_probe_work, max_probe_work);
+  diag.probing_max_probe_sweeps =
+      std::max(diag.probing_max_probe_sweeps, max_probe_sweeps);
+  diag.probing_stop = stop;
+  diag.probing_seconds += end - start;
+  diag.probing_loop_seconds += loop_end - loop_start;
+  diag.probing_work.prop_sweeps += loop_work.prop_sweeps;
+  diag.probing_work.prop_rows += loop_work.prop_rows;
+  diag.probing_work.prop_entries += loop_work.prop_entries;
+  diag.probing_work.activity_entries += loop_work.activity_entries;

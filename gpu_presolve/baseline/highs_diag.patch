+#ifndef HIGHS_UTIL_DIAG_H_
+#define HIGHS_UTIL_DIAG_H_
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+#include "util/HighsInt.h"
+
+enum HighsDiagOff {
+  kDiagOffStrengthenInequalities = 0,
+  kDiagOffDominatedColumns,
+  kDiagOffParallelColumns,
+  kDiagOffParallelRows,
+  kDiagOffSparsify,
+  kDiagOffAggregator,
+  kDiagOffFourierMotzkin,
+  kDiagOffEnumeration,
+  kDiagOffProbing,
+  kDiagOffCliqueSubstitutions,
+  kDiagOffImpliedIntegers,
+  kDiagOffCliqueMerging,
+  kDiagOffSimpleProbing,
+  kDiagOffDualFixingSubstitution,
+  kDiagOffImpliedEquations,
+  kDiagOffImpliedIntegerConversion,
+  kDiagOffDualFixingSingleEquation,
+  kDiagOffDualFixingBinarySubstitution,
+  kDiagOffDualFixingBoundStrengthening,
+  kDiagOffImpliedRowDualBounds,
+  kDiagOffCount
+};
+
+struct HighsDiagSwitches {
+  bool off[kDiagOffCount];
+  std::string off_list;
+  int64_t probing_contingent;
+  bool probing_nostop;
+  bool redundancy_explicit;
+  bool probe_rows;
+};
+
+inline HighsDiagSwitches highsDiagReadSwitches() {
+  static const char* const names[kDiagOffCount] = {
+      "strengthen_inequalities", "dominated_columns", "parallel_columns",
+      "parallel_rows",           "sparsify",          "aggregator",
+      "fourier_motzkin",         "enumeration",       "probing",
+      "clique_substitutions",    "implied_integers",  "clique_merging",
+      "simple_probing",          "dual_fixing_substitution",
+      "implied_equations",       "implied_integer_conversion",
+      "dual_fixing_single_equation",
+      "dual_fixing_binary_substitution",
+      "dual_fixing_bound_strengthening",
+      "implied_row_dual_bounds"};
+  HighsDiagSwitches switches;
+  for (int k = 0; k < kDiagOffCount; ++k) switches.off[k] = false;
+  const char* off = std::getenv("HIGHS_DIAG_OFF");
+  const std::string list = off ? off : "";
+  size_t begin = 0;
+  while (begin < list.size()) {
+    size_t end = list.find(',', begin);
+    if (end == std::string::npos) end = list.size();
+    const std::string name = list.substr(begin, end - begin);
+    int k = 0;
+    while (k < kDiagOffCount && name != names[k]) ++k;
+    if (k == kDiagOffCount) {
+      fprintf(stderr, "HIGHS_DIAG_OFF: unknown stage name \"%s\"\n",
+              name.c_str());
+      std::abort();
+    }
+    switches.off[k] = true;
+    begin = end + 1;
+  }
+  for (int k = 0; k < kDiagOffCount; ++k) {
+    if (!switches.off[k]) continue;
+    if (!switches.off_list.empty()) switches.off_list += ",";
+    switches.off_list += names[k];
+  }
+  if (switches.off_list.empty()) switches.off_list = "none";
+  switches.probing_contingent = 1000;
+  const char* contingent = std::getenv("HIGHS_DIAG_PROBING_CONTINGENT");
+  if (contingent) {
+    char* end;
+    switches.probing_contingent = std::strtoll(contingent, &end, 10);
+    if (end == contingent || *end != '\0') {
+      fprintf(stderr, "HIGHS_DIAG_PROBING_CONTINGENT: not an integer \"%s\"\n",
+              contingent);
+      std::abort();
+    }
+  }
+  const char* nostop = std::getenv("HIGHS_DIAG_PROBING_NOSTOP");
+  switches.probing_nostop = nostop && std::string(nostop) == "1";
+  const char* explicitSums = std::getenv("HIGHS_DIAG_REDUNDANCY_EXPLICIT");
+  switches.redundancy_explicit =
+      explicitSums && std::string(explicitSums) == "1";
+  const char* probeRows = std::getenv("HIGHS_DIAG_PROBE_ROWS");
+  switches.probe_rows = !(probeRows && std::string(probeRows) == "0");
+  return switches;
+}
+
+inline const HighsDiagSwitches& highsDiagSwitches() {
+  static const HighsDiagSwitches switches = highsDiagReadSwitches();
+  return switches;
+}
+
+inline bool highsDiagOff(const HighsDiagOff stage) {
+  return highsDiagSwitches().off[stage];
+}
+
+// Matrix entries visited and bounds changed by HighsDomain on the calling
+// thread
+struct HighsDiagWork {
+  int64_t prop_sweeps = 0;
+  int64_t prop_rows = 0;
+  int64_t prop_entries = 0;
+  int64_t activity_entries = 0;
+  int64_t bound_changes = 0;
+};
+
+inline HighsDiagWork& highsDiagWork() {
+  static thread_local HighsDiagWork work;
+  return work;
+}
+
+// Rows whose activity HighsDomain updates while presolve probing probes a
+// binary. A probe is one call of HighsImplications::runProbing from the
+// presolve probing loop; a direction is one of its two computeImplications
+// calls, from the fixing of the binary to the start of the backtrack. The
+// backtrack updates only rows the direction has already updated.
+struct HighsDiagTouch {
+  bool in_probe = false;
+  bool in_direction = false;
+  // in a direction and HIGHS_DIAG_PROBE_ROWS is not 0: HighsDomain marks rows
+  bool mark_rows = false;
+  std::vector<int64_t> probe_stamp;
+  std::vector<int64_t> direction_stamp;
+  int64_t probe_id = 0;
+  int64_t direction_id = 0;
+  int64_t probe_rows = 0;
+  int64_t probe_entries = 0;
+  int64_t direction_rows = 0;
+  int64_t direction_entries = 0;
+  int64_t direction_bound_changes = 0;
+
+  // sums and maxima since beginRound
+  int64_t bound_changes = 0;
+  int64_t rows = 0;
+  int64_t entries = 0;
+  int64_t max_rows = 0;
+  int64_t max_entries = 0;
+  int64_t directions = 0;
+  int64_t dir_rows = 0;
+  int64_t dir_entries = 0;
+  int64_t max_dir_rows = 0;
+  int64_t max_dir_entries = 0;
+
+  void beginRound(size_t numRow) {
+    endRound();
+    if (probe_stamp.size() < numRow) {
+      probe_stamp.resize(numRow, 0);
+      direction_stamp.resize(numRow, 0);
+    }
+    bound_changes = 0;
+    rows = 0;
+    entries = 0;
+    max_rows = 0;
+    max_entries = 0;
+    directions = 0;
+    dir_rows = 0;
+    dir_entries = 0;
+    max_dir_rows = 0;
+    max_dir_entries = 0;
+  }
+
+  // also reached when a probing round is left by an exception
+  void endRound() {
+    in_probe = false;
+    in_direction = false;
+    mark_rows = false;
+  }
+
+  void beginProbe() {
+    in_probe = true;
+    ++probe_id;
+    probe_rows = 0;
+    probe_entries = 0;
+  }
+
+  void endProbe() {
+    in_probe = false;
+    in_direction = false;
+    mark_rows = false;
+    rows += probe_rows;
+    entries += probe_entries;
+    max_rows = std::max(max_rows, probe_rows);
+    max_entries = std::max(max_entries, probe_entries);
+  }
+
+  void beginDirection() {
+    if (!in_probe) return;
+    in_direction = true;
+    mark_rows = highsDiagSwitches().probe_rows;
+    ++direction_id;
+    direction_rows = 0;
+    direction_entries = 0;
+    direction_bound_changes = highsDiagWork().bound_changes;
+  }
+
+  void endDirection() {
+    if (!in_direction) return;
+    in_direction = false;
+    mark_rows = false;
+    ++directions;
+    bound_changes += highsDiagWork().bound_changes - direction_bound_changes;
+    dir_rows += direction_rows;
+    dir_entries += direction_entries;
+    max_dir_rows = std::max(max_dir_rows, direction_rows);
+    max_dir_entries = std::max(max_dir_entries, direction_entries);
+  }
+
+  void mark(const HighsInt* rowIndex, HighsInt count,
+            const HighsInt* rowStart) {
+    for (HighsInt k = 0; k != count; ++k) {
+      const HighsInt row = rowIndex[k];
+      if (direction_stamp[row] == direction_id) continue;
+      direction_stamp[row] = direction_id;
+      const int64_t length = rowStart[row + 1] - rowStart[row];
+      ++direction_rows;
+      direction_entries += length;
+      if (probe_stamp[row] == probe_id) continue;
+      probe_stamp[row] = probe_id;
+      ++probe_rows;
+      probe_entries += length;
+    }
+  }
+};
+
+inline HighsDiagTouch& highsDiagTouch() {
+  static thread_local HighsDiagTouch touch;
+  return touch;
+}
+
+inline double highsDiagSeconds() {
+  return std::chrono::duration<double>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+#endif

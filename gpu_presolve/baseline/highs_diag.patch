+const char* HPresolve::diagStageName(HighsInt stage) {
+  static const char* const names[kDiagStageCount] = {
+      "setup",
+      "initial_scan",
+      "fast_loop",
+      "clique_substitutions",
+      "fourier_motzkin",
+      "aggregator",
+      "sparsify",
+      "parallel_rows_cols",
+      "strengthen_inequalities",
+      "dominated_columns",
+      "enumeration",
+      "implied_integers",
+      "probing",
+      "shrink",
+      "final_scaling"};
+  return names[stage];
+}
+
+void HPresolve::diagSize(int64_t& rows, int64_t& cols, int64_t& nnz) const {
+  if (diag_.have_matrix) {
+    rows = model->num_row_ - numDeletedRows;
+    cols = model->num_col_ - numDeletedCols;
+    nnz = numNonzeros();
+  } else {
+    rows = model->num_row_;
+    cols = model->num_col_;
+    nnz = model->a_matrix_.numNz();
+  }
+}
+
+HPresolve::DiagStageScope::DiagStageScope(HPresolve& presolve, DiagStage stage)
+    : presolve(presolve), active(presolve.diag_.active_stage == -1) {
+  if (!active) return;
+  presolve.diag_.active_stage = stage;
+  presolve.diagSize(rows, cols, nnz);
+  reductions = presolve.diag_.postsolve_stack->numReductions();
+  start = highsDiagSeconds();
+}
+
+HPresolve::DiagStageScope::~DiagStageScope() {
+  if (!active) return;
+  const double seconds = highsDiagSeconds() - start;
+  Diag& diag = presolve.diag_;
+  DiagStageData& data = diag.stage[diag.active_stage];
+  int64_t rowsNow;
+  int64_t colsNow;
+  int64_t nnzNow;
+  presolve.diagSize(rowsNow, colsNow, nnzNow);
+  ++data.calls;
+  data.seconds += seconds;
+  data.rows += rows - rowsNow;
+  data.cols += cols - colsNow;
+  data.nnz += nnz - nnzNow;
+  diag.postsolve_stack->diagCountReductions(
+      reductions, diag.reductions[diag.active_stage]);
+  diag.active_stage = -1;
+}
+
+void HPresolve::diagReport(double seconds, int64_t rows, int64_t cols,
+                           int64_t nnz, int64_t integerCols) const {
+  const HighsLogOptions& log_options = options->log_options;
+  const HighsDiagSwitches& switches = highsDiagSwitches();
+  highsLogUser(log_options, HighsLogType::kInfo,
+               "DIAG switches off=%s probing_contingent=%" PRId64
+               " probing_nostop=%d\n",
+               switches.off_list.c_str(), switches.probing_contingent,
+               switches.probing_nostop);
+
+  int64_t rowsNow;
+  int64_t colsNow;
+  int64_t nnzNow;
+  diagSize(rowsNow, colsNow, nnzNow);
+  DiagStageData other;
+  other.seconds = seconds;
+  other.rows = rows - rowsNow;
+  other.cols = cols - colsNow;
+  other.nnz = nnz - nnzNow;
+  const char* stageFormat = "DIAG stage name=%s calls=%" PRId64
+                            " seconds=%.6f rows_removed=%" PRId64
+                            " cols_removed=%" PRId64 " nnz_removed=%" PRId64
+                            "\n";
+  for (HighsInt stage = 0; stage != kDiagStageCount; ++stage) {
+    const DiagStageData& data = diag_.stage[stage];
+    highsLogUser(log_options, HighsLogType::kInfo, stageFormat,
+                 diagStageName(stage), data.calls, data.seconds, data.rows,
+                 data.cols, data.nnz);
+    other.seconds -= data.seconds;
+    other.rows -= data.rows;
+    other.cols -= data.cols;
+    other.nnz -= data.nnz;
+  }
+  highsLogUser(log_options, HighsLogType::kInfo, stageFormat, "other",
+               other.calls, other.seconds, other.rows, other.cols, other.nnz);
+
+  static const char* const reductionNames
+      [HighsPostsolveStack::kDiagReductionTypeCount] = {
+          "linear_transform",
+          "free_col_substitution",
+          "doubleton_equation",
+          "equality_row_addition",
+          "equality_row_additions",
+          "singleton_row",
+          "fixed_col",
+          "redundant_row",
+          "implied_equation",
+          "forcing_row",
+          "forcing_column",
+          "forcing_column_removed_row",
+          "duplicate_row",
+          "duplicate_column",
+          "zero_obj_singleton_col",
+          "fourier_motzkin_block",
+          "fourier_motzkin_obj_col"};
+  auto logReductions = [&](const char* stage, const int64_t* counts,
+                              bool always) {
+    int64_t sum = 0;
+    std::string fields;
+    for (HighsInt type = 0;
+         type != HighsPostsolveStack::kDiagReductionTypeCount; ++type) {
+      sum += counts[type];
+      fields += std::string(" ") + reductionNames[type] + "=" +
+                std::to_string(counts[type]);
+    }
+    if (sum != 0 || always)
+      highsLogUser(log_options, HighsLogType::kInfo,
+                   "DIAG reductions stage=%s%s\n", stage, fields.c_str());
+  };
+  int64_t allReductions[HighsPostsolveStack::kDiagReductionTypeCount] = {};
+  diag_.postsolve_stack->diagCountReductions(diag_.reductions_start,
+                                             allReductions);
+  int64_t otherReductions[HighsPostsolveStack::kDiagReductionTypeCount];
+  std::copy(allReductions,
+            allReductions + HighsPostsolveStack::kDiagReductionTypeCount,
+            otherReductions);
+  for (HighsInt stage = 0; stage != kDiagStageCount; ++stage) {
+    logReductions(diagStageName(stage), diag_.reductions[stage], false);
+    for (HighsInt type = 0;
+         type != HighsPostsolveStack::kDiagReductionTypeCount; ++type)
+      otherReductions[type] -= diag_.reductions[stage][type];
+  }
+  logReductions("other", otherReductions, false);
+  logReductions("all", allReductions, true);
+
+  highsLogUser(
+      log_options, HighsLogType::kInfo,
+      "DIAG probing binaries=%" PRId64 " probed=%" PRId64 " rounds=%" PRId64
+      " stop=%s fixed=%" PRId64 " substitutions=%" PRId64
+      " cliques_before=%" PRId64 " cliques_after=%" PRId64
+      " implications=%" PRId64 " seconds=%.6f probing_work=%" PRId64
+      " attempted=%" PRId64 " bounds_tightened=%" PRId64
+      " lifted_nonzeros=%" PRId64 " loop_seconds=%.6f prop_sweeps=%" PRId64
+      " prop_rows=%" PRId64 " prop_entries=%" PRId64
+      " activity_entries=%" PRId64 " max_probe_work=%" PRId64
+      " max_probe_sweeps=%" PRId64 "\n",
+      diag_.probing_binaries, diag_.probing_probed, diag_.probing_rounds,
+      diag_.probing_stop, diag_.probing_fixed, diag_.probing_substitutions,
+      diag_.probing_cliques_before, diag_.probing_cliques_after,
+      diag_.probing_implications, diag_.probing_seconds,
+      diag_.probing_work.prop_entries + diag_.probing_work.activity_entries,
+      diag_.probing_attempted, diag_.probing_bounds_tightened,
+      diag_.probing_lifted_nonzeros, diag_.probing_loop_seconds,
+      diag_.probing_work.prop_sweeps, diag_.probing_work.prop_rows,

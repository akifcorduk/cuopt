+  const int64_t integerColsNow =
+      std::count(model->integrality_.begin(), model->integrality_.end(),
+                 HighsVarType::kInteger);
+  const int64_t impliedIntegerCols =
+      std::count(model->integrality_.begin(), model->integrality_.end(),
+                 HighsVarType::kImplicitInteger);
+  const char* status = "not_set";
+  switch (presolve_status_) {
+    case HighsPresolveStatus::kNotSet:

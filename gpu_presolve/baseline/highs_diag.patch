+  }
+  highsLogUser(log_options, HighsLogType::kInfo,
+               "DIAG fixing name=total count=%" PRId64 " nnz=%" PRId64
+               " fixed_col=%" PRId64 "\n",
+               fixingCount, fixingNnz,
+               allReductions[HighsPostsolveStack::kDiagReductionFixedCol]);
+
+  int64_t boundChanges = 0;
+  for (HighsInt cause = 0; cause != kDiagBoundCount; ++cause) {
+    if (diag_.bound_change_count[cause] == 0) continue;
+    boundChanges += diag_.bound_change_count[cause];
+    highsLogUser(log_options, HighsLogType::kInfo,
+                 "DIAG bound_change name=%s count=%" PRId64 "\n",
+                 diagBoundCauseName(cause), diag_.bound_change_count[cause]);
+  }
+  highsLogUser(log_options, HighsLogType::kInfo,
+               "DIAG bound_change name=total count=%" PRId64 "\n",
+               boundChanges);
+
+  highsLogUser(log_options, HighsLogType::kInfo,
+               "DIAG dominated_columns pair_tests=%" PRId64
+               " signature_rejects=%" PRId64 " fixed=%" PRId64
+               " bounds=%" PRId64 " seconds=%.6f calls=%" PRId64
+               " type_rejects=%" PRId64 " cost_rejects=%" PRId64
+               " column_scans=%" PRId64 " scan_entries=%" PRId64
+               " dominations=%" PRId64 "\n",
+               diag_.domcol_pair_tests, diag_.domcol_signature_rejects,
+               diag_.domcol_fixed, diag_.domcol_bounds,
+               diag_.stage[kDiagDominatedColumns].seconds, diag_.domcol_calls,
+               diag_.domcol_type_rejects, diag_.domcol_cost_rejects,
+               diag_.domcol_column_scans, diag_.domcol_scan_entries,
+               diag_.domcol_dominations);
+
+  const int64_t integerColsNow =
+      std::count(model->integrality_.begin(), model->integrality_.end(),
+                 HighsVarType::kInteger);
+  const int64_t impliedIntegerCols =
+      std::count(model->integrality_.begin(), model->integrality_.end(),
+                 HighsVarType::kImplicitInteger);
+  const char* status = "not_set";
+  switch (presolve_status_) {
+    case HighsPresolveStatus::kNotSet:
+      break;
+    case HighsPresolveStatus::kNotPresolved:
+      status = "not_presolved";
+      break;
+    case HighsPresolveStatus::kNotReduced:
+      status = "not_reduced";
+      break;
+    case HighsPresolveStatus::kInfeasible:
+      status = "infeasible";
+      break;
+    case HighsPresolveStatus::kUnboundedOrInfeasible:
+      status = "unbounded_or_infeasible";
+      break;
+    case HighsPresolveStatus::kReduced:
+      status = "reduced";
+      break;
+    case HighsPresolveStatus::kReducedToEmpty:
+      status = "reduced_to_empty";
+      break;
+    case HighsPresolveStatus::kTimeout:
+      status = "timeout";
+      break;
+    case HighsPresolveStatus::kNullError:
+      status = "null_error";
+      break;
+    case HighsPresolveStatus::kOptionsError:
+      status = "options_error";
+      break;
+    case HighsPresolveStatus::kOutOfMemory:
+      status = "out_of_memory";
+      break;
+    case HighsPresolveStatus::kException:
+      status = "exception";
+      break;
+    case HighsPresolveStatus::kMatrixValueError:
+      status = "matrix_value_error";
+      break;
+  }
+  highsLogUser(log_options, HighsLogType::kInfo,
+               "DIAG total presolve_seconds=%.6f rows=%" PRId64 ":%" PRId64
+               " cols=%" PRId64 ":%" PRId64 " nnz=%" PRId64 ":%" PRId64
+               " integer_cols=%" PRId64 ":%" PRId64
+               " implied_integer_cols=%" PRId64
+               " status=%s stopped=%d restart=%" HIGHSINT_FORMAT "\n",
+               seconds, rows, rowsNow, cols, colsNow, nnz, nnzNow, integerCols,
+               integerColsNow, impliedIntegerCols, status, diag_.stopped,
+               mipsolver->mipdata_->numRestarts);
+}
+
 }  // namespace presolve

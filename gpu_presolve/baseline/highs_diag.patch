+const char* HPresolve::diagStageName(HighsInt stage) {
+  static const char* const names[kDiagStageCount] = {
+      "setup",
+      "initial_scan",
+      "fast_loop",
+      "clique_substitutions",
+      "fourier_motzkin",
+      "aggregator",
+      "sparsify",
+      "parallel_rows_cols",
+      "strengthen_inequalities",
+      "dominated_columns",
+      "enumeration",
+      "implied_integers",
+      "probing",
+      "shrink",
+      "final_scaling"};
+  return names[stage];
+}
+
+const char* HPresolve::diagBoundCauseName(HighsInt cause) {
+  static const char* const names[kDiagBoundCount] = {
+      "input",
+      "other",
+      "implied_bound",
+      "binary_row_test",
+      "doubleton",
+      "singleton_row",
+      "dual_fixing",
+      "dominated_columns_pairwise",
+      "implied_integer",
+      "transform",
+      "parallel_columns",
+      "equation_gcd",
+      "probing_prepare",
+      "probing",
+      "clique_table"};
+  return names[cause];
+}
+
+std::string HPresolve::diagFixingName(HighsInt rule) {
+  static const char* const names[kDiagFixBoundsEqual] = {
+      "other",
+      "empty_col",
+      "forcing_row",
+      "dominated_col",
+      "weakly_dominated_col",
+      "dual_fixing_lock",
+      "dual_fixing_single_equation",
+      "dual_fixing_bound",
+      "singleton_row_bounds_equal",
+      "simple_probing",
+      "equation_gcd",
+      "col_stuffing",
+      "parallel_columns",
+      "dominated_columns_pairwise",
+      "clique_row_normalisation",
+      "enumeration",
+      "probing"};
+  if (rule < kDiagFixBoundsEqual) return names[rule];
+  return std::string("bounds_equal_") +
+         diagBoundCauseName(rule - kDiagFixBoundsEqual);
+}
+
+void HPresolve::diagCountFixing(HighsInt rule, HighsInt col) {
+  ++diag_.fixing_count[rule];
+  diag_.fixing_nnz[rule] += colsize[col];
+}
+
+void HPresolve::diagCountFreeColSubstitution(HighsInt row, HighsInt col) {
+  DiagFreeColSubstitution& data =
+      diag_.free_col_substitution[diag_.active_stage == kDiagAggregator];
+  ++data.count;
+  if (model->integrality_[col] == HighsVarType::kInteger) ++data.integer;
+  if (isEquation(row)) {
+    ++data.equation;
+    return;
+  }
+  // the side dualImpliedFreeGetRhsAndRowType takes, and the column that the
+  // implied bound on the row dual of that side was derived from
+  const bool upperSide = isDualImpliedLeq(row);
+  const HighsInt source =
+      upperSide ? rowDualUpperSource[row] : rowDualLowerSource[row];
+  if (upperSide) ++data.upper_side;
+  if (isRanged(row)) ++data.ranged;
+  if (source == col) {
+    ++data.inequality_own;
+    if (model->col_cost_[col] == 0.0) ++data.own_zero_cost;
+  } else {
+    ++data.inequality_other;
+  }
+}
+
+void HPresolve::diagBoundChanged(HighsInt col, DiagBoundCause cause) {
+  if (diag_.bound_cause.size() < static_cast<size_t>(model->num_col_))
+    diag_.bound_cause.resize(model->num_col_, kDiagBoundInput);
+  diag_.bound_cause[col] = cause;
+  ++diag_.bound_change_count[cause];
+}
+
+HighsInt HPresolve::diagBoundCause(HighsInt col) const {
+  return static_cast<size_t>(col) < diag_.bound_cause.size()
+             ? diag_.bound_cause[col]
+             : kDiagBoundInput;
+}
+
+// called by shrinkProblem when model->num_col_ is the new number of columns
+void HPresolve::diagShrinkCols(const std::vector<HighsInt>& newColIndex) {
+  std::vector<uint8_t>& cause = diag_.bound_cause;
+  cause.resize(newColIndex.size(), kDiagBoundInput);
+  for (size_t i = 0; i != newColIndex.size(); ++i)
+    if (newColIndex[i] != -1) cause[newColIndex[i]] = cause[i];
+  cause.resize(model->num_col_);
+}
+
+void HPresolve::diagSize(int64_t& rows, int64_t& cols, int64_t& nnz) const {
+  if (diag_.have_matrix) {
+    rows = model->num_row_ - numDeletedRows;
+    cols = model->num_col_ - numDeletedCols;
+    nnz = numNonzeros();
+  } else {
+    rows = model->num_row_;
+    cols = model->num_col_;
+    nnz = model->a_matrix_.numNz();
+  }
+}
+
+HPresolve::DiagStageScope::DiagStageScope(HPresolve& presolve, DiagStage stage)
+    : presolve(presolve), active(presolve.diag_.active_stage == -1) {
+  if (!active) return;
+  presolve.diag_.active_stage = stage;
+  presolve.diagSize(rows, cols, nnz);
+  reductions = presolve.diag_.postsolve_stack->numReductions();
+  start = highsDiagSeconds();
+}
+
+HPresolve::DiagStageScope::~DiagStageScope() {
+  if (!active) return;
+  const double seconds = highsDiagSeconds() - start;
+  Diag& diag = presolve.diag_;
+  DiagStageData& data = diag.stage[diag.active_stage];
+  int64_t rowsNow;
+  int64_t colsNow;
+  int64_t nnzNow;
+  presolve.diagSize(rowsNow, colsNow, nnzNow);
+  ++data.calls;
+  data.seconds += seconds;
+  data.rows += rows - rowsNow;
+  data.cols += cols - colsNow;
+  data.nnz += nnz - nnzNow;
+  diag.postsolve_stack->diagCountReductions(
+      reductions, diag.reductions[diag.active_stage]);
+  diag.active_stage = -1;
+}
+
+void HPresolve::diagReport(double seconds, int64_t rows, int64_t cols,
+                           int64_t nnz, int64_t integerCols) const {
+  const HighsLogOptions& log_options = options->log_options;
+  const HighsDiagSwitches& switches = highsDiagSwitches();
+  highsLogUser(log_options, HighsLogType::kInfo,
+               "DIAG switches off=%s probing_contingent=%" PRId64
+               " probing_nostop=%d redundancy_explicit=%d probe_rows=%d\n",
+               switches.off_list.c_str(), switches.probing_contingent,
+               switches.probing_nostop, switches.redundancy_explicit,
+               switches.probe_rows);
+
+  int64_t rowsNow;
+  int64_t colsNow;
+  int64_t nnzNow;
+  diagSize(rowsNow, colsNow, nnzNow);
+  DiagStageData other;
+  other.seconds = seconds;
+  other.rows = rows - rowsNow;
+  other.cols = cols - colsNow;
+  other.nnz = nnz - nnzNow;
+  const char* stageFormat = "DIAG stage name=%s calls=%" PRId64
+                            " seconds=%.6f rows_removed=%" PRId64
+                            " cols_removed=%" PRId64 " nnz_removed=%" PRId64
+                            "\n";
+  for (HighsInt stage = 0; stage != kDiagStageCount; ++stage) {
+    const DiagStageData& data = diag_.stage[stage];
+    highsLogUser(log_options, HighsLogType::kInfo, stageFormat,
+                 diagStageName(stage), data.calls, data.seconds, data.rows,
+                 data.cols, data.nnz);
+    other.seconds -= data.seconds;
+    other.rows -= data.rows;
+    other.cols -= data.cols;
+    other.nnz -= data.nnz;
+  }
+  highsLogUser(log_options, HighsLogType::kInfo, stageFormat, "other",
+               other.calls, other.seconds, other.rows, other.cols, other.nnz);
+
+  static const char* const reductionNames
+      [HighsPostsolveStack::kDiagReductionTypeCount] = {
+          "linear_transform",
+          "free_col_substitution",
+          "doubleton_equation",
+          "equality_row_addition",
+          "equality_row_additions",
+          "singleton_row",
+          "fixed_col",
+          "redundant_row",
+          "implied_equation",
+          "forcing_row",
+          "forcing_column",
+          "forcing_column_removed_row",
+          "duplicate_row",
+          "duplicate_column",
+          "zero_obj_singleton_col",
+          "fourier_motzkin_block",
+          "fourier_motzkin_obj_col"};
+  auto logReductions = [&](const char* stage, const int64_t* counts,
+                              bool always) {
+    int64_t sum = 0;
+    std::string fields;
+    for (HighsInt type = 0;
+         type != HighsPostsolveStack::kDiagReductionTypeCount; ++type) {
+      sum += counts[type];
+      fields += std::string(" ") + reductionNames[type] + "=" +
+                std::to_string(counts[type]);
+    }
+    if (sum != 0 || always)
+      highsLogUser(log_options, HighsLogType::kInfo,
+                   "DIAG reductions stage=%s%s\n", stage, fields.c_str());
+  };
+  int64_t allReductions[HighsPostsolveStack::kDiagReductionTypeCount] = {};
+  diag_.postsolve_stack->diagCountReductions(diag_.reductions_start,
+                                             allReductions);
+  int64_t otherReductions[HighsPostsolveStack::kDiagReductionTypeCount];
+  std::copy(allReductions,
+            allReductions + HighsPostsolveStack::kDiagReductionTypeCount,
+            otherReductions);
+  for (HighsInt stage = 0; stage != kDiagStageCount; ++stage) {
+    logReductions(diagStageName(stage), diag_.reductions[stage], false);
+    for (HighsInt type = 0;
+         type != HighsPostsolveStack::kDiagReductionTypeCount; ++type)
+      otherReductions[type] -= diag_.reductions[stage][type];
+  }
+  logReductions("other", otherReductions, false);
+  logReductions("all", allReductions, true);
+
+  highsLogUser(
+      log_options, HighsLogType::kInfo,
+      "DIAG probing binaries=%" PRId64 " probed=%" PRId64 " rounds=%" PRId64
+      " stop=%s fixed=%" PRId64 " substitutions=%" PRId64
+      " cliques_before=%" PRId64 " cliques_after=%" PRId64
+      " implications=%" PRId64 " seconds=%.6f probing_work=%" PRId64
+      " attempted=%" PRId64 " bounds_tightened=%" PRId64
+      " lifted_nonzeros=%" PRId64 " loop_seconds=%.6f prop_sweeps=%" PRId64
+      " prop_rows=%" PRId64 " prop_entries=%" PRId64
+      " activity_entries=%" PRId64 " max_probe_work=%" PRId64
+      " max_probe_sweeps=%" PRId64 " bound_changes=%" PRId64
+      " rows_touched=%" PRId64 " rows_touched_entries=%" PRId64
+      " max_rows_touched=%" PRId64 " max_rows_touched_entries=%" PRId64
+      " probe_directions=%" PRId64 " dir_rows_touched=%" PRId64
+      " dir_rows_touched_entries=%" PRId64 " max_dir_rows_touched=%" PRId64
+      " max_dir_rows_touched_entries=%" PRId64 " probe_reductions=%" PRId64
+      "\n",
+      diag_.probing_binaries, diag_.probing_probed, diag_.probing_rounds,
+      diag_.probing_stop, diag_.probing_fixed, diag_.probing_substitutions,
+      diag_.probing_cliques_before, diag_.probing_cliques_after,
+      diag_.probing_implications, diag_.probing_seconds,
+      diag_.probing_work.prop_entries + diag_.probing_work.activity_entries,
+      diag_.probing_attempted, diag_.probing_bounds_tightened,
+      diag_.probing_lifted_nonzeros, diag_.probing_loop_seconds,
+      diag_.probing_work.prop_sweeps, diag_.probing_work.prop_rows,
+      diag_.probing_work.prop_entries, diag_.probing_work.activity_entries,
+      diag_.probing_max_probe_work, diag_.probing_max_probe_sweeps,
+      diag_.probing_bound_changes, diag_.probing_rows_touched,
+      diag_.probing_rows_touched_entries, diag_.probing_max_rows_touched,
+      diag_.probing_max_rows_touched_entries, diag_.probing_directions,
+      diag_.probing_dir_rows_touched, diag_.probing_dir_rows_touched_entries,
+      diag_.probing_max_dir_rows_touched,
+      diag_.probing_max_dir_rows_touched_entries, diag_.probing_reductions);
+
+  highsLogUser(log_options, HighsLogType::kInfo,
+               "DIAG cliquemerge calls=%" PRId64
+               " seconds=%.6f rows_changed=%" PRId64 " rows_deleted=%" PRId64
+               " nnz_delta=%" PRId64 " nnz_added=%" PRId64
+               " nnz_removed=%" PRId64 " fixings=%" PRId64 "\n",
+               diag_.cliquemerge_calls, diag_.cliquemerge_seconds,
+               diag_.cliquemerge_rows_changed, diag_.cliquemerge_rows_deleted,
+               diag_.cliquemerge_nnz_added - diag_.cliquemerge_nnz_removed,
+               diag_.cliquemerge_nnz_added, diag_.cliquemerge_nnz_removed,
+               diag_.cliquemerge_fixings);
+
+  highsLogUser(log_options, HighsLogType::kInfo,
+               "DIAG aggregator candidates=%" PRId64 " substituted=%" PRId64
+               " size2=%" PRId64 " rejected_pivot=%" PRId64
+               " rejected_fillin=%" PRId64 " stopped_by_failures=%" PRId64
+               " examined=%" PRId64 " stale=%" PRId64
+               " rejected_integer=%" PRId64 "\n",
+               diag_.aggregator_candidates, diag_.aggregator_substituted,
+               diag_.aggregator_size2, diag_.aggregator_rejected_pivot,
+               diag_.aggregator_rejected_fillin,
+               diag_.aggregator_stopped_by_failures, diag_.aggregator_examined,
+               diag_.aggregator_stale, diag_.aggregator_rejected_integer);
+
+  for (HighsInt k = 0; k != 2; ++k) {
+    const DiagFreeColSubstitution& data = diag_.free_col_substitution[k];
+    highsLogUser(log_options, HighsLogType::kInfo,
+                 "DIAG free_col_substitution name=%s count=%" PRId64
+                 " equation=%" PRId64 " inequality_own=%" PRId64
+                 " inequality_other=%" PRId64 " upper_side=%" PRId64
+                 " ranged=%" PRId64 " own_zero_cost=%" PRId64
+                 " integer=%" PRId64 "\n",
+                 k == 0 ? "singleton_col" : "aggregator", data.count,
+                 data.equation, data.inequality_own, data.inequality_other,
+                 data.upper_side, data.ranged, data.own_zero_cost,
+                 data.integer);
+  }
+
+  int64_t doubletonRemoved = diag_.doubleton_removed[0];
+  std::string doubletonByStage;
+  for (HighsInt stage = 0; stage != kDiagStageCount; ++stage) {
+    doubletonRemoved += diag_.doubleton_removed[stage + 1];
+    doubletonByStage += std::string(" ") + diagStageName(stage) + "=" +
+                        std::to_string(diag_.doubleton_removed[stage + 1]);
+  }
+  doubletonByStage += " other=" + std::to_string(diag_.doubleton_removed[0]);
+  highsLogUser(log_options, HighsLogType::kInfo,
+               "DIAG doubleton removed=%" PRId64 "%s\n", doubletonRemoved,
+               doubletonByStage.c_str());
+
+  int64_t substitutionsImplication = 0;
+  int64_t substitutionsClique = 0;
+  for (HighsInt stage = 0; stage != kDiagStageCount + 1; ++stage) {
+    substitutionsImplication += diag_.substitutions_implication[stage];
+    substitutionsClique += diag_.substitutions_clique[stage];
+  }
+  highsLogUser(
+      log_options, HighsLogType::kInfo,
+      "DIAG substitutions applied=%" PRId64 " from_implications=%" PRId64
+      " from_cliques=%" PRId64 " in_clique_substitutions=%" PRId64
+      " in_enumeration=%" PRId64 " in_probing=%" PRId64
+      " simple_probing=%" PRId64 " dual_fixing=%" PRId64 "\n",
+      substitutionsImplication + substitutionsClique, substitutionsImplication,
+      substitutionsClique,
+      diag_.substitutions_implication[kDiagCliqueSubstitutions + 1] +
+          diag_.substitutions_clique[kDiagCliqueSubstitutions + 1],
+      diag_.substitutions_implication[kDiagEnumeration + 1] +
+          diag_.substitutions_clique[kDiagEnumeration + 1],
+      diag_.substitutions_implication[kDiagProbing + 1] +
+          diag_.substitutions_clique[kDiagProbing + 1],
+      diag_.substitutions_simple_probing, diag_.substitutions_dual_fixing);
+
+  for (HighsInt k = 0; k != 2; ++k) {
+    const DiagVarBound& data = diag_.varbound[k];
+    highsLogUser(log_options, HighsLogType::kInfo,
